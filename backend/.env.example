# =============================================================================
# SecureBank Server Environment Configuration Template
# =============================================================================
# Copy this file to .env in the server directory and populate with actual credentials.
# NEVER commit the actual .env file or real secrets to version control.

# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGO_URI=mongodb://localhost:27017/securebank

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=1d

# Frontend Client URL
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Nodemailer / SMTP Email Service Configuration
# Compatible with Gmail SMTP, Mailtrap, Outlook, SendGrid, Amazon SES, etc.
# Note: For Gmail, use SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, and generate an App Password.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Finova
MAIL_FROM_ADDRESS=security@finovabank.com

# AI Fraud Detection Service (FastAPI Python microservice)
ML_SERVICE_URL=http://127.0.0.1:8000
