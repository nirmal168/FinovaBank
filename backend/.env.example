# =============================================================================
# SecureBank Server Environment Configuration Template
# =============================================================================
# Copy this file to .env in the server directory and populate with actual credentials.
# NEVER commit the actual .env file or real secrets to version control.

# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGO_URI=mongodb://localhost:27017/securebank

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=1d

# Frontend Client URL (for CORS and cookie origin matching)
CLIENT_URL=http://localhost:5173

# Email / SMTP Configuration (for OTP delivery)
# If not configured, OTP falls back cleanly to development console logging
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=SecureBank Security <security@securebank.internal>

# AI Fraud Detection Service (FastAPI Python microservice)
ML_SERVICE_URL=http://127.0.0.1:8000
